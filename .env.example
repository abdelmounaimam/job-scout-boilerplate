# Copy to .env (gitignored) and fill in. Read by tools/deploy-dashboard.sh.
#
# Railway identifiers of the dashboard service. Find them with `railway status`
# or in the project settings. They are passed explicitly because the deploy
# runs from a temporary directory linked to no project: without them,
# `railway up` offers to create a NEW project at every deployment.
RAILWAY_PROJECT_ID=
# ⚠️ Railway demands --environment as soon as --project is given.
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_NAME=dashboard

# Basic-auth password of the dashboard, 12 characters minimum.
# ⚠️ It is set ON THE HOST, never here and never committed:
#   railway variables --set DASHBOARD_PASSWORD=<a-long-password>
# Listed only so `bun server.ts` can be tried locally with an exported value.
# DASHBOARD_PASSWORD=
# Optional: overrides DASHBOARD.basicAuthUser from profile/profile.mjs.
# DASHBOARD_USER=

# Public URL of the deployed dashboard, read by tools/pull-scores.sh to mirror
# the scores of the Evaluations tab into evals/scores.jsonl.
# DASHBOARD_URL=https://<service>.up.railway.app

# ⚠️ Scores of the Evaluations tab: SQLite at SCORES_DB. Set it ON THE HOST, to a
# path on a volume, or every deploy wipes them (see evals/README.md):
#   railway volume add --mount-path /data   (with --project/--environment/--service)
#   railway variable set SCORES_DB=/data/scores.sqlite
# Locally, any temporary path: SCORES_DB=/tmp/scores.sqlite bun server.ts
# SCORES_DB=
